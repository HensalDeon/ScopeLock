  "narrative": {
    "northStar": "The Signed Ledger",
    "overview": "ScopeLock looks like an accounts book that is also a contract. Every screen is a ledger of what was agreed, what was added, what was asked for and what was paid, and every figure on it has to be trustworthy at a glance. The interface is ink on white paper: hairline rules separate rows, numbers sit in tabular columns, and small monospaced labels name each column the way a printed ledger would.\n\nRestraint is the personality. The app is a precise working tool for a freelancer at a laptop (and a quick check on the phone), so nothing decorates: no gradients, no glowing shapes, no icon grids, no cards stacked on shadows. Colour carries meaning, not mood: ink navy is the only action colour, emerald appears only when something is settled (approved, done, money received), and amber only when something is waiting. When the client sees a proposal, change request or invoice, the screen changes register: the document becomes a sheet of paper on a warm desk, set in a serif, because that is the artefact they are signing.",
    "keyCharacteristics": [
      "Ink on paper: navy text and actions on white, cool slate-tinted greys.",
      "Meaning-only colour: emerald means settled, amber means waiting, red means fix this.",
      "Ledger structure: rows divided by hairlines, figures right-aligned in tabular numerals.",
      "Mono uppercase labels for column heads and figure captions.",
      "Flat app surfaces; only client documents lift off the page.",
      "Compact and crisp: 32px controls, 8px corners, no ornament."
    ],
    "rules": [
      {
        "name": "The Settled Green Rule",
        "body": "Emerald appears only when something is settled: approved, done, received or recovered. Never as a button, a heading accent or decoration. Three fixed exceptions echo the mark: the Focus Lock core, the focus ring, and the active sidebar item's icon.",
        "section": "colors"
      },
      {
        "name": "The Ink Action Rule",
        "body": "Every action is ink navy. A screen has at most one filled ink button for the next step; everything else is outline or ghost.",
        "section": "colors"
      },
      {
        "name": "The Waiting Amber Rule",
        "body": "Amber marks only things waiting on a person (the client or you), and always pairs a wash background with waiting ink text, never amber text on white.",
        "section": "colors"
      },
      {
        "name": "The Tabular Figures Rule",
        "body": "Every amount, count, date and reference number uses tabular numerals, so columns of money line up digit for digit.",
        "section": "colors"
      },
      {
        "name": "The Serif Is For Signing Rule",
        "body": "Cormorant Garamond appears only inside client-facing documents (proposal, change request, invoice cover). The app chrome never uses it.",
        "section": "typography"
      },
      {
        "name": "The Summary Then Log Rule",
        "body": "Detail pages summarise the latest few items; full histories live on their own paged pages (\"See all 12\").",
        "section": "layout"
      },
      {
        "name": "The Flat Tool Rule",
        "body": "App panels, cards and rows never carry shadows. If something needs to stand apart, give it a hairline border or a tone, not a shadow.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep every action ink navy (#0b1220), with one filled button per view for the next step.",
      "**Do** reserve emerald (#0e9f6e) for approved, done, received and money recovered, and amber (#b45309 with #fdf3e3 / #7a3d06) for waiting.",
      "**Do** set every amount, date and reference in tabular numerals and right-align figures in columns.",
      "**Do** use mono uppercase labels (11px, 0.12em tracking) for column heads and figure captions.",
      "**Do** separate rows with hairlines (#e3e6eb) inside 11px-cornered panels, with totals in a canvas-grey footer.",
      "**Do** show real product content as the design: rupee amounts, CR numbers, client names, dates like \"18 Nov, 3:42 pm\".",
      "**Do** check every screen at 390px wide."
    ],
    "donts": [
      "**Don't** use gradients, glowing blobs or decorative illustrations.",
      "**Don't** add shadows to app panels or cards; only client documents and overlays lift.",
      "**Don't** put `rounded-2xl` plus a shadow on every block, or build icon-in-a-circle feature grids.",
      "**Don't** use emerald for buttons, links, headings or decoration.",
      "**Don't** centre everything in app screens; content is left-aligned, figures right-aligned.",
      "**Don't** use the serif in the app chrome; it belongs to client documents.",
      "**Don't** redraw the Focus Lock mark; use `<Logo />`, `<LogoMark />` and `<BrandLoader />`."
    ]
  }
}
