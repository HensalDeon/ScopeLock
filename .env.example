# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the app (used for links in emails, client portal URLs, metadata)
APP_URL=http://localhost:3000

# MongoDB Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scopelock
