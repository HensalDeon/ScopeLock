# Copy to .env.local and fill in. Never commit real secrets.

# Public base URL of the app (links in emails, client portal URLs, auth callbacks)
APP_URL=http://localhost:3000

# Header with the visitor's real IP (rate limits, approval records).
# Vercel: x-forwarded-for (default). Behind nginx: x-real-ip, with
#   proxy_set_header X-Real-IP $remote_addr;
CLIENT_IP_HEADER=x-forwarded-for

# MongoDB Atlas → Database → Connect → Drivers → copy the connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.<id>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=scopelock

# Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Google sign-in (optional). Console → APIs & Services → Credentials → OAuth client (Web).
# Authorised redirect URI: <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Optional in development: emails (and their codes) print to the terminal.
# Required in production: without it, verification and reset codes can't be delivered.
# Any SMTP provider works: Resend, Brevo, Zoho, Gmail app password…
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ScopeLock <no-reply@yourdomain.com>"
# Optional override: smtp | console. "console" prints emails to the terminal;
# in production it's only accepted with a localhost APP_URL (local testing).
EMAIL_TRANSPORT=
